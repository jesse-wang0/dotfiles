[user]
	name = Jesse Wang
	email = jesse21532@gmail.com
	username = jesse-wang0
[init]
	defaultBranch = main
[alias]
	#############
	s = status -sb
	a = add
	c = commit
	cm = commit -m
	ca = commit --amend
	#############
	pl = pull --rebase
	ps = push
	pfl = push --force-with-lease
	#############
	d = diff
	#############
	co = checkout
	cob = checkout -b
	br = for-each-ref --sort=-committerdate --format="%(committerdate:relative)%09%(objectname:short)%09%(refname:short)" refs/heads
	wt = worktree
	#############
	l = log --oneline --graph --decorate
    hist = log --pretty=format:\"%C(yellow)%h%Creset %ad | %s%Cgreen%d%Creset [%an]\" --graph --date=short
